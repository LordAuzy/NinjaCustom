<?xml version="1.0" encoding="utf-8" ?>

<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Error"
      internalLogFile="C:/temp/nlog-internal.log">

  <extensions>
    <add assembly="NinjaTrader.Custom"/>
  </extensions>


  <!-- ======================================================= -->
  <!-- Variables                                               -->
  <!-- ======================================================= -->

  <variable name="archiveDateFormat"
            value="yyyy-MM-dd-HH.mm.ss"/>

  <variable name="maxArchiveFiles"
            value="10"/>

  <variable name="OldlayoutShort" value="${event-properties:item=SimTime:format=yyMMdd HH\:mm\:ss.fff:whenEmpty=${date:format=yyMMdd HH\:mm\:ss.fff}}|${level:uppercase=true:format=FirstCharacter}|${callsite:includeNamespace=false}|${message} ${exception:format=tostring}"/>
  <variable name="layoutShort" value="${event-properties:item=SimTime:format=yyMMdd HH\:mm\:ss.fff:whenEmpty=${date:format=yyMMdd HH\:mm\:ss.fff}}|${level:uppercase=true:format=FirstCharacter}|${callsite:includeNamespace=false:skipFrames=2}|${message} ${exception:format=tostring}"/>

  <!-- ======================================================= -->
  <!-- Targets                                                 -->
  <!-- ======================================================= -->

  <targets>

    <!-- ===================================================== -->
    <!-- Diagnostic                                            -->
    <!-- ===================================================== -->

    <target xsi:type="File"
            name="diagnostic"
            keepFileOpen="true"

            fileName="${event-properties:item=LogDirectory}/diagnostic.log"

            archiveFileName="${event-properties:item=LogDirectory}/archives/diagnostic.{#}.log"

            archiveEvery="Day"
            archiveAboveSize="10242880"
            archiveNumbering="Date"
            archiveDateFormat="${archiveDateFormat}"
            maxArchiveFiles="${maxArchiveFiles}"

            layout="${layoutShort}" />


    <!-- ===================================================== -->
    <!-- Trace                                                 -->
    <!-- ===================================================== -->

    <target xsi:type="AsyncWrapper"
            name="asyncTrace"
            queueLimit="10000"
            overflowAction="Discard">

      <target xsi:type="File"
              name="trace"
              keepFileOpen="true"

              fileName="${event-properties:item=LogDirectory}/trace.log"

              archiveFileName="${event-properties:item=LogDirectory}/archives/trace.{#}.log"

              archiveEvery="Day"
              archiveAboveSize="10242880"
              archiveNumbering="Date"
              archiveDateFormat="${archiveDateFormat}"
              maxArchiveFiles="${maxArchiveFiles}"

              layout="${layoutShort}" />

    </target>

    <!-- ===================================================== -->
    <!-- Run Summary Log                                       -->
    <!-- ===================================================== -->
    <target xsi:type="File"
            name="runSummary"
            keepFileOpen="false"
            fileName="${event-properties:item=LogDirectory}/Runs/RunSummary_${event-properties:item=RunId}.log"
            layout="${message}" />        
    
    <!-- ===================================================== -->
    <!-- Human-readable Trade Log                              -->
    <!-- ===================================================== -->
    <target xsi:type="File"
        name="tradeLog"
        keepFileOpen="true"
        xxfileName="${event-properties:item=LogDirectory}/Trades/Trades_v${gdc:item=TradeCSVSchemaVersion}_${event-properties:item=SimTime:format=yyyy-MM:whenEmpty=${date:format=yyyy-MM}}.log"
        fileName="${event-properties:item=LogDirectory}/Trades/Trades_v${gdc:item=TradeCSVSchemaVersion}_${event-properties:item=RunId}.log"            
        layout="${message}" />

    <!-- ===================================================== -->
    <!-- Trade CSV                                             -->
    <!-- ===================================================== -->
    <target xsi:type="File"
        name="tradeCSV"
        keepFileOpen="true"
        xxfileName="${event-properties:item=LogDirectory}/Trades/Trades_v${gdc:item=TradeCSVSchemaVersion}_${event-properties:item=SimTime:format=yyyy-MM:whenEmpty=${date:format=yyyy-MM}}.csv"
        fileName="${event-properties:item=LogDirectory}/Trades/Trades_v${gdc:item=TradeCSVSchemaVersion}_${event-properties:item=RunId}.csv"            
        layout="${message}" />

    <!-- ===================================================== -->
    <!-- Trade Bar Telemetry CSV                               -->
    <!-- ===================================================== -->
    <target xsi:type="File"
        name="telemetryCSV"
        keepFileOpen="true"
        fileName="${event-properties:item=LogDirectory}/Trades/TradeBarTelemetry_v${gdc:item=TradeBarsCSVSchemaVersion}_${event-properties:item=RunId}.csv"                        
        layout="${message}" />

    <!-- ===================================================== -->
    <!-- NinjaTrader Output Window                             -->
    <!-- ===================================================== -->

    <target xsi:type="NinjaTraderOutput"
            name="ntOutput"
            layout="${message} ${exception:format=tostring}" />


    <!-- ===================================================== -->
    <!-- Visual Studio                                         -->
    <!-- ===================================================== -->

    <target xsi:type="Debugger"
            name="debugger"
            layout="${time} | ${level:uppercase=true} | ${logger} | ${message} ${exception:format=tostring}" />

  </targets>


  <!-- ======================================================= -->
  <!-- Rules                                                   -->
  <!-- ======================================================= -->

  <rules>

    <!--
        Structured data loggers are FINAL.

        Their messages go only to their corresponding file and
        do not fall through to trace/diagnostic/output targets.
    -->

    <logger name="TelemetryTradeExecutionCSV"
            minlevel="Info"
            writeTo="telemetryCSV"
            final="true" />

    <logger name="TradeExecutionCSV"
            minlevel="Info"
            writeTo="tradeCSV"
            final="true" />

    <logger name="TradeExecution"
            minlevel="Info"
            writeTo="tradeLog"
            final="true" />

    <logger name="RunSummary"
            minlevel="Info"
            writeTo="runSummary"
            final="true" />    

    <!--
        Normal strategy logging.

        Trace file:
            receives Trace and above.

        Diagnostic:
            receives Debug and above.

        NinjaTrader Output:
            receives Warn and above.
    -->

    <logger name="Strategy"
            minlevel="Trace"
            writeTo="asyncTrace" />

    <logger name="Strategy"
            minlevel="Debug"
            writeTo="diagnostic,debugger" />

    <logger name="Strategy"
            minlevel="Warn"
            writeTo="ntOutput" />

  </rules>

</nlog>
 